# ============================================================
# BDI Shopify-style minimal template — env vars
# ============================================================
# Copy to `.env.local` and fill in. All NEXT_PUBLIC_* vars are
# exposed to the browser; everything else stays server-side.
# ------------------------------------------------------------

# --- BDI platform identity (required for dynamic-brand fetch) ---
NEXT_PUBLIC_BDI_ORGANIZATION_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Shopify Storefront API (required for products + checkout) ---
# e.g. mystore.myshopify.com  (NOT the storefront URL)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API access token (read-only, public)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Shopify multi-tenant tag-filter (optional) ---
# Used when many tenants share one BDI Shopify store.
# Each product is tagged "bdi-org:<organization_id>" and the
# storefront filters by that tag. Leave blank for a tenant with
# their own dedicated Shopify store.
BDI_ORG_TAG_PREFIX=bdi-org
BDI_ORGANIZATION_ID=

# --- Shopify Admin API (optional, for write ops) ---
SHOPIFY_ADMIN_API_TOKEN=

# --- Brand fallbacks (used when get_tenant_brand RPC is unset) ---
NEXT_PUBLIC_BRAND_NAME=My Store
NEXT_PUBLIC_BRAND_FULL_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=Shop the latest products.
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_OG_IMAGE=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BRAND_COLOR=#0019FF
NEXT_PUBLIC_BRAND_ACCENT=#00C774
NEXT_PUBLIC_CURRENCY=USD
